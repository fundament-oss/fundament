# System files
.DS_Store
Thumbs.db

.claude

# Terraform provider binary
terraform-provider/terraform-provider
*.lock.hcl
*.tfstate
*.tfstate.backup
.terraform

terraform-provider/terraform-provider-fundament

# functl binary (built by `go build`; release artifacts are built in CI)
functl/functl
functl/functl.exe

# Local k3d kubeconfig (generated by `just cluster-create`)
deploy/k3d/kubeconfig.yaml

# Generated by `just cluster-worker gardener-connect-k3d`
charts/fundament/values-gardener-local.yaml

# Dev dependencies (cloned repos, generated kubeconfigs)
.dev/

# Sandbox plugin config recorded by recipes like `just openfsc::operator-push`
plugins/*/.sandbox-config

# npm's lockfile in a bun workspace. The frontends resolve through bun.lock,
# and running npm or npx in one of them leaves a second lockfile behind that
# nobody reads and that drifts from the one that counts.
package-lock.json
