# E2E Test Configuration
BASE_URL=https://console.fundament.localhost:8443
AUTHN_API_URL=https://authn.fundament.localhost:8443
ORGANIZATION_API_URL=https://organization.fundament.localhost:8443
PLUGIN_PROXY_URL=https://plugin-proxy.fundament.localhost:8443

# Browser configuration (NixOS requires BROWSER_PATH to system Chromium)
# BROWSER_PATH: Direct path to browser executable (use on NixOS)
# BROWSER_CHANNEL: Branded browser channel ('chrome', 'msedge') - not for system Chromium
BROWSER_PATH=

# @real-gardener node pool provisioning test (just e2e test-tags @real-gardener)
# Only runs against a real Gardener (just cluster-worker gardener-up + just dev -p local-gardener).
# E2E_CLUSTER_NAME=tf-a
# E2E_CLUSTER_OWNER_EMAIL=alice@acme-corp.com
# E2E_SEED_CONTEXT=kind-gardener-operator-local
# E2E_SEED_NODE=gardener-operator-local-control-plane
# E2E_NODE_POOL_MACHINE_TYPE=local-small

