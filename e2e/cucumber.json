{
  "default": {
    "import": ["steps/**/*.ts", "support/**/*.ts"],
    "tags": "not @real-gardener",
    "format": [
      "progress-bar",
      "json:reports/cucumber-report.json",
      "html:reports/cucumber-report.html"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    }
  },
  "full": {
    "import": ["steps/**/*.ts", "support/**/*.ts"],
    "format": [
      "progress-bar",
      "json:reports/cucumber-report.json",
      "html:reports/cucumber-report.html"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    }
  }
}
