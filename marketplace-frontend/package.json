{
  "name": "fundament-marketplace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:registry": "ng serve --configuration registry",
    "start:admin": "ng serve --configuration admin",
    "build": "ng build",
    "build:registry": "ng build --configuration production,registry",
    "build:admin": "ng build --configuration production,admin",
    "build:demo": "ng build --configuration production,demo --base-href /marketplace/",
    "serve:ssr": "node dist/fundament-marketplace/server/server.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write ."
  },
  "packageManager": "bun@1.4.3",
  "overrides": {
    "@jridgewell/sourcemap-codec": "1.6.0"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.3",
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@nldd/design-system": "0.8.91",
    "express": "^5.3.0",
    "marked": "18.1.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-airbnb-extended": "3.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
