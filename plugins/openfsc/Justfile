kube_context := env("kube_context", "k3d-fundament-plugin")
registry_port := "5112"

# The published operator image is amd64 only; on arm64 it crashes. Set the printed ref as
# PluginInstallation spec.config OPERATOR_IMAGE before the first install: the plugin
# deploys the operator only when its release is absent.

# Build and push the openfsc-operator image for the sandbox cluster
operator-push:
    #!/usr/bin/env bash
    set -euo pipefail
    docker build -t openfsc-operator:local -f ../../openfsc-operator/Dockerfile ../..
    # A new tag per build: the operator Deployment pulls IfNotPresent.
    image="localhost:{{ registry_port }}/openfsc-operator:$(git describe --always --dirty)-$(docker images -q openfsc-operator:local)"
    docker tag openfsc-operator:local "${image}"
    docker push "${image}"
    echo "OPERATOR_IMAGE: ${image}"

# Verify the OpenFSC install: PluginInstallation Running + sample FSCInstallation Active
test:
    #!/usr/bin/env bash
    set -euo pipefail
    k="kubectl --context {{ kube_context }}"
    echo "Waiting for PluginInstallation/system--openfsc to be Running (first install pulls many images)..."
    $k wait --for=jsonpath='{.status.phase}'=Running plugininstallation/system--openfsc --timeout=900s
    echo "Creating the fsc-demo namespace and the sample FSCInstallation..."
    $k create namespace fsc-demo --dry-run=client -o yaml | $k apply -f -
    $k apply -f ../../openfsc-operator/config/samples/openfsc_v1_fscinstallation.yaml
    echo "Waiting for the FSCInstallation to become Active (core + gateways registered)..."
    $k wait --for=jsonpath='{.status.phase}'=Active fscinstallation/demo -n fsc-demo --timeout=900s
    echo "Verifying the one-installation-per-namespace guard..."
    $k apply -f - <<'EOF'
    apiVersion: openfsc.fundament.io/v1
    kind: FSCInstallation
    metadata:
      name: conflict
      namespace: fsc-demo
    spec:
      groupID: fsc-demo
      peerID: "11111111111111111111"
      directory:
        mode: Self
      postgres:
        storageClass: local-path
    EOF
    $k wait --for=jsonpath='{.status.phase}'=Error fscinstallation/conflict -n fsc-demo --timeout=120s
    $k delete fscinstallation/conflict -n fsc-demo
    echo "Verifying the conflict deletion left the active installation untouched..."
    $k get deploy fsc-open-fsc-manager -n fsc-demo > /dev/null
    $k wait --for=jsonpath='{.status.phase}'=Active fscinstallation/demo -n fsc-demo --timeout=120s
    $k get fscinstallations -A
    $k -n fsc-demo get pods,deploy

# The operator's finalizer tears down the releases; cert-manager, CloudNativePG and the operator stay.
# Remove the sample FSCInstallation and its namespace
test-cleanup:
    kubectl --context {{ kube_context }} delete fscinstallation/demo -n fsc-demo --ignore-not-found
    kubectl --context {{ kube_context }} delete namespace fsc-demo --ignore-not-found

# Live CR data via kubectl, no Console host needed; needs an FSCInstallation.
# Preview the built console UI against the sandbox
console-preview port="4319":
    #!/usr/bin/env bash
    set -euo pipefail
    # Shared /plugin-ui/{plugin-sdk,nldd}.{js,css} bundle (preview == prod):
    (cd ../../console-frontend && bun install && bun run build:plugin-ui)
    # The plugin's own console UI (Vite) → console/, served same-origin:
    (cd console-ui && bun install && bun run build)
    PORT={{ port }} kube_context={{ kube_context }} bun scripts/console-preview/serve.js

# Runs the console-preview backend (stand-in SDK + /api/* + the shared /plugin-ui bundle) and
# the Vite dev server, which proxies to it (see console-ui/vite.config.ts). Open the printed
# Vite URL + /fscinstallations-list.html; needs an FSCInstallation.
# Develop the console UI with Vite HMR against the sandbox
console-dev port="4319" vite_port="5173":
    #!/usr/bin/env bash
    set -euo pipefail
    (cd ../../console-frontend && bun install && bun run build:plugin-ui)
    PORT={{ port }} kube_context={{ kube_context }} bun scripts/console-preview/serve.js &
    backend=$!
    trap "kill $backend 2>/dev/null || true" EXIT
    cd console-ui && bun install && bun run dev -- --port {{ vite_port }}
