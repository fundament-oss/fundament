export kube_context := "k3d-fundament-plugin"

_default:
    @just --list

# Apply sample DiskPool to verify ceph-rook works end-to-end.
#
# Disk names are cluster-specific, so test-resources.yaml ships a placeholder.
# The guard catches an unedited file instead of burning the 300s wait.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    kubectl() { command kubectl --context {{ kube_context }} "$@"; }

    if grep -q 'placeholder-node-loop0p1' test-resources.yaml; then
        echo "test-resources.yaml still lists the placeholder disk." >&2
        echo "Put real Disk names in spec.disks first:" >&2
        echo >&2
        kubectl get disks 2>/dev/null >&2 || echo "  (no Disk CRs yet -- is the plugin installed?)" >&2
        exit 1
    fi

    kubectl apply -f test-resources.yaml

    # A pool resolving no disks goes Degraded, not Ready: report why.
    echo "Waiting for DiskPool to become Ready..."
    if ! kubectl wait --for=jsonpath='{.status.phase}'=Ready diskpool/test-pool --timeout=300s; then
        echo >&2
        echo "DiskPool did not become Ready. Status:" >&2
        kubectl get diskpool test-pool -o jsonpath='{.status.phase}: {.status.message}{"\n"}' >&2
        exit 1
    fi

    # A BlockStorage with no OSD capacity goes Degraded, not Ready: report why.
    echo "Waiting for BlockStorage to become Ready..."
    if ! kubectl wait --for=jsonpath='{.status.phase}'=Ready blockstorage/test-block --timeout=300s; then
        echo >&2
        echo "BlockStorage did not become Ready. Status:" >&2
        kubectl get blockstorage test-block -o jsonpath='{.status.phase}: {.status.message}{"\n"}' >&2
        exit 1
    fi

    # A FileStorage with no OSD capacity goes Degraded, not Ready: report why.
    echo "Waiting for FileStorage to become Ready..."
    if ! kubectl wait --for=jsonpath='{.status.phase}'=Ready filestorage/test-file --timeout=300s; then
        echo >&2
        echo "FileStorage did not become Ready. Status:" >&2
        kubectl get filestorage test-file -o jsonpath='{.status.phase}: {.status.message}{"\n"}' >&2
        exit 1
    fi

    # An ObjectStorage with no OSD capacity goes Degraded, not Ready: report why.
    echo "Waiting for ObjectStorage to become Ready..."
    if ! kubectl wait --for=jsonpath='{.status.phase}'=Ready objectstorage/test-object --timeout=300s; then
        echo >&2
        echo "ObjectStorage did not become Ready. Status:" >&2
        kubectl get objectstorage test-object -o jsonpath='{.status.phase}: {.status.message}{"\n"}' >&2
        exit 1
    fi

    # The claim goes in only after the store is Ready: applied earlier it sits
    # in the OBC provisioner's exponential backoff (capped at ~17 min), which
    # can outlast this wait on a healthy plugin.
    kubectl apply -f - <<'YAML'
    apiVersion: objectbucket.io/v1alpha1
    kind: ObjectBucketClaim
    metadata:
      name: test-bucket
    spec:
      generateBucketName: test-bucket
      storageClassName: cephobj-test-object
    YAML

    echo "Waiting for ObjectBucketClaim to bind..."
    if ! kubectl wait --for=jsonpath='{.status.phase}'=Bound objectbucketclaim/test-bucket --timeout=300s; then
        echo >&2
        echo "ObjectBucketClaim did not bind. Status:" >&2
        kubectl get objectbucketclaim test-bucket -o jsonpath='{.status.phase}{"\n"}' >&2
        exit 1
    fi

    kubectl get diskpool test-pool
    kubectl get blockstorage test-block
    kubectl get filestorage test-file
    kubectl get objectstorage test-object
    kubectl get objectbucketclaim test-bucket
    kubectl get storageclass

# Remove the sample resources
test-cleanup:
    #!/usr/bin/env bash
    set -euo pipefail
    kubectl() { command kubectl --context {{ kube_context }} "$@"; }
    # The claim must be fully gone first: its finalizer needs the StorageClass
    # and RGW still present to deprovision the bucket (rook#7351), so one-pass
    # deletion wedges it forever.
    kubectl delete objectbucketclaim test-bucket --ignore-not-found --wait=true
    kubectl delete -f test-resources.yaml --ignore-not-found
