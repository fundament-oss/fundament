{
  "name": "fundament-console",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:plugin-ui": "bun build src/plugin-sdk/plugin-sdk.ts --outfile public/plugin-ui/plugin-sdk.js --target browser --format iife --minify && bun src/plugin-sdk/build-css.ts && bun build src/plugin-sdk/nldd-design-system-entry.ts --outfile public/plugin-ui/nldd-design-system.js --target browser --format iife --minify && bun src/plugin-sdk/build-nldd-design-system-css.ts",
    "prebuild": "node generate-proto-version.js && bun run build:plugin-ui",
    "build": "ng build",
    "prestart": "bun run prebuild",
    "prestart:demo": "bun run prebuild",
    "start:demo": "ng serve --configuration demo",
    "prebuild:demo": "bun run prebuild",
    "build:demo": "ng build --configuration production,demo",
    "prewatch": "bun run prebuild",
    "watch": "ng build --watch --configuration development",
    "pretest": "node generate-proto-version.js",
    "test": "ng test",
    "prelint": "node generate-proto-version.js",
    "lint": "ng lint",
    "format": "prettier --write ."
  },
  "packageManager": "bun@1.4.0",
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      },
      {
        "files": "src/app/**/*.html",
        "options": {
          "singleAttributePerLine": true
        }
      }
    ]
  },
  "overrides": {
    "@bufbuild/protobuf": "2.14.0"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/router": "22.1.3",
    "@bufbuild/protobuf": "2.14.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@hey-api/client-fetch": "0.13.1",
    "@nldd/design-system": "^0.8.84",
    "chart.js": "4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.3",
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@connectrpc/protoc-gen-connect-es": "1.7.0",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "22.1.0",
    "eslint": "10.9.0",
    "eslint-config-airbnb-extended": "3.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "happy-dom": "^20.11.6",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
