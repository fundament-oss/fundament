apiVersion: plugins.fundament.io/v1
kind: PluginInstallation
metadata:
  name: {{.InstallationName}}
  annotations:
    plugins.fundament.io/dev-mode: "true"
spec:
  definitionRef:
    organizationName: {{.OrgName}}
    pluginName: {{.Layout.Name}}
    pluginVersion: {{printf "%q" .Version}}
    definitionHash: ""
  dev:
    # Bare name: skaffold's resourceSelector rewrites this to the
    # fully-qualified tag@digest it built. A digest here would block injection.
    image: {{.ImageName}}
