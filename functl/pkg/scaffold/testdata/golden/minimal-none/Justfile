# Demo
#
# Requires just (https://just.systems) and Go.
# Run `just` or `just --list` to see every recipe.

image := env("IMAGE", "demo-plugin")
# Images target x86 cluster nodes whatever the build machine, an Apple Silicon
# Mac included; e.g. PLATFORM=linux/arm64 for an arm64 cluster.
platform := env("PLATFORM", "linux/amd64")

_default:
    @just --list

# Build the plugin binary
build:
    go build -o demo-plugin .

# Run the tests
test:
    go test ./... -count=1

# Lint, if golangci-lint is installed
lint:
    @command -v golangci-lint >/dev/null 2>&1 && golangci-lint run ./... || echo "golangci-lint not installed, skipping"

# Build the container image, e.g. `just docker v1.0.0`
docker tag="dev":
    docker buildx build --load --provenance=false --sbom=false --platform {{ platform }} -t {{ image }}:{{ tag }} .

# Remove build output
clean:
    rm -f demo-plugin
