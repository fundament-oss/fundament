---
// Required here as well as in src/styles/starlight-custom.css: customCss only
// applies to Starlight-rendered doc pages, and this layout is outside that
// pipeline, so the landing page would otherwise ship without the design system.
import '@nldd/design-system/styles';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fundament',
  description = 'Fundament - Open-source platform for deploying and managing Kubernetes clusters with bare-metal provisioning',
} = Astro.props;

const { pathname } = Astro.url;
const isActive = (path: string) => pathname === path || pathname === `${path}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/img/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <link rel="shortcut icon" href="/img/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <nldd-app-view>
    <nldd-page>
    <nldd-skip-link slot="header" text="Skip navigation">
      <nldd-top-navigation-bar
        logo-href="/"
        website-title="Fundament"
        website-href="/"
        width="1280px"
      >
        <nldd-menu-bar slot="global">
          <nldd-menu-bar-item text="Home" href="/" current={isActive('/') ? '' : undefined} />
          <nldd-menu-bar-item text="About" href="/about" current={isActive('/about') ? '' : undefined} />
          <nldd-menu-bar-item text="Docs" href="/docs" current={isActive('/docs') ? '' : undefined} />
        </nldd-menu-bar>
        <nldd-menu-bar slot="utility">
          {/* The three appearance choices as radio items, the way the console
              account menu offers them. The script below marks the current one and
              writes it to the same key Starlight reads, so the docs follow. */}
          <nldd-menu-bar-item
            id="appearance-menu"
            text="Appearance"
            expandable
          >
            <nldd-menu>
              <nldd-menu-item data-scheme="auto" text="System" icon="display" type="radio" />
              <nldd-menu-item data-scheme="light" text="Light" icon="light-mode" type="radio" />
              <nldd-menu-item data-scheme="dark" text="Dark" icon="dark-mode" type="radio" />
            </nldd-menu>
          </nldd-menu-bar-item>
          <nldd-menu-bar-item
            text="GitHub"
            href="https://github.com/fundament-oss/fundament"
            target="_blank"
            rel="nofollow noopener noreferrer"
          />
        </nldd-menu-bar>
      </nldd-top-navigation-bar>
    </nldd-skip-link>

    <slot />

    {/* Only a legal bar: the whole footer is one line, and that is the row the
        design system reserves for it. The lintje comes with it. */}
    <nldd-page-footer slot="footer" width="1280px">
      <nldd-page-footer-legal-bar slot="legal-bar">
        <nldd-page-footer-legal-bar-item slot="start" text="Fundament · Open source · AGPL" />
        <nldd-page-footer-legal-bar-item
          slot="end"
          text="Digilab"
          href="https://digilab.overheid.nl/"
          target="_blank"
          rel="noopener noreferrer"
        />
        <nldd-page-footer-legal-bar-item
          slot="end"
          text="GitHub"
          href="https://github.com/fundament-oss/fundament"
          target="_blank"
          rel="nofollow noopener noreferrer"
        />
      </nldd-page-footer-legal-bar>
    </nldd-page-footer>
    </nldd-page>
    </nldd-app-view>
  </body>
</html>

<script>
  import '@nldd/design-system/button';
  import '@nldd/design-system/icon';
  import '@nldd/design-system/icon-button';
  import '@nldd/design-system/top-navigation-bar';
  import '@nldd/design-system/skip-link';
  import '@nldd/design-system/menu-bar';
  import '@nldd/design-system/menu-bar-item';
  import '@nldd/design-system/menu';
  import '@nldd/design-system/page-footer';
  import '@nldd/design-system/page';
  import '@nldd/design-system/app-view';
</script>

<script is:inline>
  /* eslint-disable */
  (function () {
    var htmlEl = document.documentElement;
    var media = window.matchMedia('(prefers-color-scheme: dark)');

    /* 'auto' rather than 'system', because Starlight reads the same key and
       that is the word it uses. The menu says System, which is what a reader
       expects to see. */
    function paint(choice) {
      var isDark = choice === 'dark' || (choice === 'auto' && media.matches);
      htmlEl.dataset.scheme = isDark ? 'dark' : 'light';
      htmlEl.classList.toggle('dark', isDark);

      var menu = document.getElementById('appearance-menu');
      if (!menu) return;
      menu.querySelectorAll('nldd-menu-item[data-scheme]').forEach(function (item) {
        item.toggleAttribute('selected', item.dataset.scheme === choice);
      });
    }

    var saved = localStorage.getItem('starlight-theme') || localStorage.getItem('fnd-scheme');
    var choice = saved === 'dark' || saved === 'light' || saved === 'auto' ? saved : 'auto';
    paint(choice);

    /* Following the system means following it while the page is open, not only
       at load: a laptop that switches at sunset switches this page with it. */
    media.addEventListener('change', function () {
      if (choice === 'auto') paint(choice);
    });

    document.addEventListener('select', function (event) {
      var item = event.target.closest && event.target.closest('nldd-menu-item[data-scheme]');
      if (!item) return;
      choice = item.dataset.scheme;
      localStorage.setItem('starlight-theme', choice);
      localStorage.setItem('fnd-scheme', choice);
      paint(choice);
    });
  })();
</script>
