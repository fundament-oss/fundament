---
import Layout from '../layouts/Landing.astro';
import GitHubMark from '../components/GitHubMark.astro';
---

<Layout title="Fundament: Self-hosted Kubernetes platform">
  <nldd-hero main-width="full" width="1280px">
    <nldd-text size="lg" weight="medium" color="inherit">
      Self-hosted Kubernetes platform
    </nldd-text>
    <nldd-spacer size="4"></nldd-spacer>
    <nldd-title size="1" color="inherit">
      <h1>Deploy and manage Kubernetes clusters with confidence.</h1>
    </nldd-title>
    <nldd-spacer size="16"></nldd-spacer>
    <nldd-rich-text color="inherit">
      <p>
        Fundament is an open-source platform that combines bare-metal provisioning with managed
        Kubernetes, delivering a complete IaaS and PaaS solution for self-hosted infrastructure.
      </p>
    </nldd-rich-text>
    <nldd-spacer size="24"></nldd-spacer>
    <nldd-button-group orientation="horizontal">
      <nldd-button
        variant="inherit-filled"
        href="/docs"
        text="Read the documentation"
        start-icon="book"
      ></nldd-button>
      <nldd-button
        variant="inherit-tinted"
        text="View on GitHub"
        href="https://github.com/fundament-oss/fundament"
        target="_blank"
        rel="nofollow noopener noreferrer"
      >
        <GitHubMark slot="start-icon" />
      </nldd-button>
    </nldd-button-group>
  </nldd-hero>

  <!-- Capabilities -->
  <nldd-simple-section width="1280px">
    <nldd-title slot="header" size="2">
      <h2>A complete cloud platform, self-hosted.</h2>
    </nldd-title>
    <nldd-spacer slot="header" size="8"></nldd-spacer>
    <nldd-text slot="header" size="lg" color="secondary">
      Eight capabilities that define Fundament. No managed service required, no proprietary
      lock-in, no compromises on isolation.
    </nldd-text>
    <nldd-collection item-width="280px">
      <nldd-card>
        <nldd-container padding="16">
          <nldd-icon name="terminal" size="40" box custom-color="oklch(0.897 0.044 253.4)"></nldd-icon>
          <nldd-spacer size="12"></nldd-spacer>
          <nldd-title size="5">
            <h3>Developer-friendly</h3>
          </nldd-title>
          <nldd-text color="secondary">Simple, intuitive platform for deploying and operating applications without wrestling with infrastructure complexity.</nldd-text>
        </nldd-container>
      </nldd-card>
      <nldd-card>
        <nldd-container padding="16">
          <nldd-icon name="rectangle-stack" size="40" box custom-color="oklch(0.897 0.044 253.4)"></nldd-icon>
          <nldd-spacer size="12"></nldd-spacer>
          <nldd-title size="5">
            <h3>Multi-tenant architecture</h3>
          </nldd-title>
          <nldd-text color="secondary">Built for organizational growth with strict tenant isolation and shared-nothing compute and storage architecture.</nldd-text>
        </nldd-container>
      </nldd-card>
      <nldd-card>
        <nldd-container padding="16">
          <nldd-icon name="shield-check-mark" size="40" box custom-color="oklch(0.897 0.044 253.4)"></nldd-icon>
          <nldd-spacer size="12"></nldd-spacer>
          <nldd-title size="5">
            <h3>Secure by default</h3>
          </nldd-title>
          <nldd-text color="secondary">Security built into every layer with zero-trust principles and comprehensive isolation between tenants.</nldd-text>
        </nldd-container>
      </nldd-card>
      <nldd-card>
        <nldd-container padding="16">
          <nldd-icon name="cloud" size="40" box custom-color="oklch(0.897 0.044 253.4)"></nldd-icon>
          <nldd-spacer size="12"></nldd-spacer>
          <nldd-title size="5">
            <h3>Managed infrastructure</h3>
          </nldd-title>
          <nldd-text color="secondary">Compute, storage, and networking abstracted and managed, with automated bare-metal provisioning via metal-stack.</nldd-text>
        </nldd-container>
      </nldd-card>
      <nldd-card>
        <nldd-container padding="16">
          <nldd-icon name="check-mark-circle" size="40" box custom-color="oklch(0.897 0.044 253.4)"></nldd-icon>
          <nldd-spacer size="12"></nldd-spacer>
          <nldd-title size="5">
            <h3>Highly available</h3>
          </nldd-title>
          <nldd-text color="secondary">Designed to remain operational under heavy demand or failure conditions with built-in resilience.</nldd-text>
        </nldd-container>
      </nldd-card>
      <nldd-card>
        <nldd-container padding="16">
          <nldd-icon name="chart-x-y-axis-line" size="40" box custom-color="oklch(0.897 0.044 253.4)"></nldd-icon>
          <nldd-spacer size="12"></nldd-spacer>
          <nldd-title size="5">
            <h3>Horizontally scalable</h3>
          </nldd-title>
          <nldd-text color="secondary">Scale from a handful to thousands of tenants with large infrastructure footprints without architectural changes.</nldd-text>
        </nldd-container>
      </nldd-card>
      <nldd-card>
        <nldd-container padding="16">
          <nldd-icon name="puzzle-piece" size="40" box custom-color="oklch(0.897 0.044 253.4)"></nldd-icon>
          <nldd-spacer size="12"></nldd-spacer>
          <nldd-title size="5">
            <h3>Extensible platform</h3>
          </nldd-title>
          <nldd-text color="secondary">Pluggable services allow tenants to autonomously evolve and customize their technology stack.</nldd-text>
        </nldd-container>
      </nldd-card>
      <nldd-card>
        <nldd-container padding="16">
          <nldd-icon name="brackets-ellipsis" size="40" box custom-color="oklch(0.897 0.044 253.4)"></nldd-icon>
          <nldd-spacer size="12"></nldd-spacer>
          <nldd-title size="5">
            <h3>Open source</h3>
          </nldd-title>
          <nldd-text color="secondary">Built on proven open-source projects like metal-stack and Gardener, avoiding proprietary lock-in.</nldd-text>
        </nldd-container>
      </nldd-card>
    </nldd-collection>
  </nldd-simple-section>

  <!-- Architecture -->
  <nldd-one-third-two-thirds-section width="1280px">
    <nldd-title slot="left" size="2">
      <h2>Built on proven foundations.</h2>
    </nldd-title>
    <nldd-spacer slot="left" size="8"></nldd-spacer>
    <nldd-text slot="left" size="lg" color="secondary">
      Fundament combines best-in-class open-source technologies to deliver a complete cloud
      solution.
    </nldd-text>
    <nldd-container gap="8">
      <nldd-card>
        <nldd-container padding="16">
          <nldd-text size="xs" color="secondary">IaaS layer</nldd-text>
          <nldd-title size="4">
            <h3>metal-stack</h3>
          </nldd-title>
          <nldd-text color="secondary">Automated bare-metal provisioning for reliable, high-performance infrastructure.</nldd-text>
        </nldd-container>
      </nldd-card>
      <nldd-container padding-left="16">
        <nldd-title size="3" aria-hidden="true">
          <span>+</span>
        </nldd-title>
      </nldd-container>
      <nldd-card>
        <nldd-container padding="16">
          <nldd-text size="xs" color="secondary">Orchestration</nldd-text>
          <nldd-title size="4">
            <h3>Gardener</h3>
          </nldd-title>
          <nldd-text color="secondary">Enterprise-grade Kubernetes cluster management at scale.</nldd-text>
        </nldd-container>
      </nldd-card>
      <nldd-container padding-left="16">
        <nldd-title size="3" aria-hidden="true">
          <span>=</span>
        </nldd-title>
      </nldd-container>
      <nldd-card>
        <nldd-container padding="16">
          <nldd-text size="xs" color="secondary">Complete solution</nldd-text>
          <nldd-title size="4">
            <h3>Fundament</h3>
          </nldd-title>
          <nldd-text color="secondary">IaaS + PaaS for self-hosted infrastructure.</nldd-text>
        </nldd-container>
      </nldd-card>
    </nldd-container>
  </nldd-one-third-two-thirds-section>

  <!-- End CTA -->
  {/* Dezelfde opbouw als "Denk mee over deze verkenning" op regelrecht.rijks.app:
      een getinte sectie met titel, tekst en knop onder elkaar, met spacers ertussen. */}
  <nldd-simple-section
    background="tinted"
    sm-padding-block="32"
    md-padding-block="64"
    lg-padding-block="96"
    width="1280px"
  >
    <nldd-title size="2">
      <h2>Ready to get started?</h2>
    </nldd-title>
    <nldd-spacer size="8"></nldd-spacer>
    <nldd-rich-text>
      <p>Deploy Fundament in your infrastructure and start managing Kubernetes clusters today.</p>
    </nldd-rich-text>
    <nldd-spacer size="24"></nldd-spacer>
    <nldd-button-group orientation="horizontal">
      <nldd-button
        variant="primary"
        href="/docs"
        text="Read the documentation"
        start-icon="book"
      ></nldd-button>
      <nldd-button
        variant="secondary"
        text="View on GitHub"
        href="https://github.com/fundament-oss/fundament"
        target="_blank"
        rel="nofollow noopener noreferrer"
      >
        <GitHubMark slot="start-icon" />
      </nldd-button>
    </nldd-button-group>
  </nldd-simple-section>
</Layout>
<script>
  import '@nldd/design-system/hero';
  import '@nldd/design-system/text';
  import '@nldd/design-system/spacer';
  import '@nldd/design-system/title';
  import '@nldd/design-system/rich-text';
  import '@nldd/design-system/button-group';
  import '@nldd/design-system/simple-section';
  import '@nldd/design-system/collection';
  import '@nldd/design-system/one-third-two-thirds-section';
  import '@nldd/design-system/card';
  import '@nldd/design-system/container';
  import '@nldd/design-system/icon';
</script>
